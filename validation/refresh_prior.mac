/* A refresh's tempered return prior, and how far it sits from the full refit
   (mixdyn.models.bayes_mmm.tempered_spec and refresh_bayes, ADR 0079;
   tests/test_bayes_refresh.py runs this file and reads its verdicts).

   On a channel's log return u, everything is read as normal: the base prior N(mu0, 1/p0), the
   previous fit's prior N(mup, 1/pp), its posterior N(m, 1/q), so its periods' evidence is the
   posterior over the prior, precision q - pp and mean c with (q - pp) c = q m - pp mup; the new
   periods' evidence, precision ln and mean d.

     STEP 1  the base prior times the evidence to the power a is normal, of precision
             p0 + a (q - pp) and mean (p0 mu0 + a (q m - pp mup)) over it: the log densities
             differ by a constant in u
     STEP 2  at a = 0 the tempered prior is the base prior
     STEP 3  the full refit is the base prior times both evidences, precision P = p0 + lo + ln,
             lo = q - pp; the refresh is the tempered prior times both, precision P' = P + a lo.
             The refresh's mean less the full refit's is a lo (c - M) / P', M the full refit's
     STEP 4  a lo / P' <= a / (1 + a) for every p0, ln >= 0, lo > 0: the refresh's mean lies at
             most a / (1 + a) of the way from the full refit's to c; its variance over the full
             refit's, P / P', is at least 1 / (1 + a)
     STEP 5  at a = 1/4 the share is 1/5 and the spread's ratio at least 2/sqrt(5) = 0.894...

   Run: timeout 300 maxima --very-quiet -Q -b validation/refresh_prior.mac */

display2d : false$
linel : 200$
ratprint : false$
/* batch echoes the source, so the failing verdict is built here, never written whole */
verdict(ok) := if ok then "(PASS)" else sconcat("(FA", "IL)")$
zero(e) := is(ratsimp(e) = 0)$
print("================================================================")$
print("A REFRESH'S TEMPERED RETURN PRIOR")$
print("================================================================")$
assume(p0 > 0, pp > 0, q > pp, a >= 0, ln >= 0)$

/* the log of a normal density of mean mu and precision p, less its constant */
lognormal(u, mu, p) := log(p) / 2 - p * (u - mu)^2 / 2$

/* ===== STEP 1: the power prior is normal ===== */
evidence(u) := lognormal(u, m, q) - lognormal(u, mup, pp)$
precision : p0 + a * (q - pp)$
centre : (p0 * mu0 + a * (q * m - pp * mup)) / precision$
gap : expand(lognormal(u, mu0, p0) + a * evidence(u) - lognormal(u, centre, precision))$
print("STEP 1  the power prior's log density less the normal's has no u in it",
  verdict(is(ratsimp(diff(gap, u)) = 0)))$

/* ===== STEP 2: at weight 0 the base prior ===== */
print("STEP 2  at a = 0 the precision and the mean are the base prior's",
  verdict(zero(subst(a = 0, precision) - p0) and zero(subst(a = 0, centre) - mu0)))$

/* ===== STEP 3: the refresh against the full refit ===== */
lo : q - pp$
c : (q * m - pp * mup) / lo$
P : p0 + lo + ln$
full : (p0 * mu0 + lo * c + ln * d) / P$
refreshed : (precision * centre + lo * c + ln * d) / (P + a * lo)$
print("STEP 3  the refreshed mean less the full refit's is a lo (c - M) / P'",
  verdict(zero(refreshed - full - a * lo * (c - full) / (P + a * lo))))$

/* ===== STEP 4: the bounds ===== */
/* with x = lo > 0 and the rest r = p0 + ln >= 0: a x / (r + (1 + a) x) <= a / (1 + a) */
share(r, x) := a * x / (r + (1 + a) * x)$
slack : ratsimp(a / (1 + a) - share(r, x))$
print("STEP 4  a / (1 + a) less the share is", factor(slack),
  verdict(zero(slack - a * r / ((1 + a) * (r + (1 + a) * x)))))$
ratio : ratsimp(P / (P + a * lo))$
spare : ratsimp(ratio - 1 / (1 + a))$
print("STEP 4  P / P' less 1 / (1 + a) is", factor(spare),
  verdict(zero(spare - a * (p0 + ln) / ((1 + a) * (P + a * lo)))))$

/* ===== STEP 5: at the default weight ===== */
fpprec : 30$
at_default : [subst(a = 1/4, a / (1 + a)), bfloat(sqrt(subst(a = 1/4, 1 / (1 + a))))]$
print("STEP 5  at a = 1/4 the share and the spread's least ratio are", at_default,
  verdict(is(first(at_default) = 1/5)
    and is(abs(second(at_default) - 0.894427190999915878563669467492b0) < 1b-25)))$
